# Copy this file to .env and fill in your values

# Admin credentials (run `npm run setup` to generate a password hash)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Session secret — use a long random string
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Port
PORT=4000

# Gmail (use an App Password, not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=moonyogaadventures@gmail.com
GMAIL_APP_PASSWORD=

# Razorpay (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Your site's public URL (used in emails)
SITE_URL=http://localhost:4000
